{
  "tools": [
    {
      "name": "search_companies",
      "title": "Search companies",
      "description": "Search companies by free-text query and/or country. Requires the companies:read scope.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "description": "Free-text terms, e.g. \"AI companies\". Every term must match a whole word in name, industry or description.",
            "type": "string",
            "maxLength": 200
          },
          "country": {
            "description": "Exact country name, case-insensitive, e.g. Australia.",
            "type": "string",
            "maxLength": 100
          },
          "limit": {
            "description": "Max results (default 10, max 50).",
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "industry": {
                  "type": "string"
                },
                "employees": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "id",
                "name",
                "industry",
                "employees"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "results"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "get_company",
      "title": "Get company",
      "description": "Fetch one company by id. Requires the companies:read scope.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "companyId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "companyId"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "website": {
            "type": "string"
          },
          "industry": {
            "type": "string"
          },
          "employees": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "description": {
            "type": "string"
          },
          "country": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "website",
          "industry",
          "employees",
          "description",
          "country"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "search_contacts",
      "title": "Search contacts",
      "description": "Search contacts by companyId and/or jobTitle. Requires the contacts:read scope.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "companyId": {
            "description": "Company id, e.g. cmp_1.",
            "type": "string",
            "maxLength": 100
          },
          "jobTitle": {
            "description": "Case-insensitive job title text, e.g. \"Engineer\".",
            "type": "string",
            "maxLength": 100
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "contacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "title"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "contacts"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "enrich_contact",
      "title": "Enrich contact",
      "description": "Enrich one contact's email and LinkedIn via the synthetic mock provider. Requires the contacts:enrich scope. Results are synthetic fixtures, never verified real-world data.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "contactId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "contactId"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "linkedin": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "PARTIAL",
              "NOT_FOUND"
            ]
          },
          "provider": {
            "type": "string"
          },
          "provenance": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "enum": [
                    "email",
                    "linkedin"
                  ]
                },
                "source": {
                  "type": "string"
                },
                "synthetic": {
                  "type": "boolean"
                },
                "verified": {
                  "type": "boolean"
                },
                "observedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                }
              },
              "required": [
                "field",
                "source",
                "synthetic",
                "verified",
                "observedAt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "email",
          "linkedin",
          "status",
          "provider",
          "provenance"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      }
    },
    {
      "name": "export_contacts",
      "title": "Export contacts",
      "description": "Export up to 200 contacts as a CSV download link, valid for 15 minutes. Requires the contacts:export scope.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "contactIds": {
            "minItems": 1,
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        },
        "required": [
          "contactIds"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "downloadUrl": {
            "type": "string"
          },
          "exportId": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "rowCount": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "downloadUrl",
          "exportId",
          "expiresAt",
          "rowCount"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      }
    }
  ]
}
