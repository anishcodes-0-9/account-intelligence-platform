# Copy to .env. Placeholders only; never commit real secrets.
DATABASE_URL=postgresql://aip:aip_dev_password@127.0.0.1:5433/aip?schema=public
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
NODE_ENV=development
# Origin export_contacts builds download URLs on. Defaults to http://<HOST>:<PORT> if unset.
DOWNLOAD_BASE_URL=http://127.0.0.1:3001
# MCP stdio only: the API key the stdio server authenticates itself with (see `pnpm keys create`).
AIP_API_KEY=replace-me-with-a-real-key-from-pnpm-keys-create
