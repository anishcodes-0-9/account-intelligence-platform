{
  "name": "account-intelligence-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @aip/core exec prisma generate",
    "db:validate": "pnpm --filter @aip/core exec prisma validate",
    "spike:stdio": "pnpm --filter @aip/server spike:stdio",
    "spike:http": "pnpm --filter @aip/server spike:http",
    "db:migrate": "pnpm --filter @aip/core exec prisma migrate deploy",
    "db:migrate:dev": "pnpm --filter @aip/core exec prisma migrate dev",
    "db:seed": "pnpm --filter @aip/core seed",
    "keys": "pnpm --filter @aip/server keys"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
